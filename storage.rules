rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isContentAdmin() {
      return request.auth != null
        && request.auth.token.email == 'marcronielbisac@gmail.com';
    }

    function validUpload(contentPattern, maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches(contentPattern);
    }

    match /signs/gifs/{signId}/{fileName} {
      allow read: if true;
      allow write: if isContentAdmin() && validUpload('image/gif', 25 * 1024 * 1024);
    }

    match /signs/images/{signId}/{fileName} {
      allow read: if true;
      allow write: if isContentAdmin() && validUpload('image/(jpeg|png|webp)', 15 * 1024 * 1024);
    }

    match /signs/videos/{signId}/{fileName} {
      allow read: if true;
      allow write: if isContentAdmin() && validUpload('video/(mp4|quicktime|x-m4v)', 100 * 1024 * 1024);
    }

    match /lessons/images/{lessonId}/{fileName} {
      allow read: if true;
      allow write: if isContentAdmin() && validUpload('image/(jpeg|png|webp)', 15 * 1024 * 1024);
    }

    match /lessons/videos/{lessonId}/{fileName} {
      allow read: if true;
      allow write: if isContentAdmin() && validUpload('video/(mp4|quicktime|x-m4v)', 100 * 1024 * 1024);
    }
  }
}
