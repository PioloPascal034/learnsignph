rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lessons/{lessonId} { allow read, write: if true; }
    match /signs/{signId} { allow read, write: if true; }
    match /grammarExercises/{exerciseId} { allow read, write: if true; }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /lessonProgress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /activityProgress/{activityId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      match /grammarProgress/{exerciseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
